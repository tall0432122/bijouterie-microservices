# =============================================================================
# Configuration Nginx du frontend
# -----------------------------------------------------------------------------
# Ce fichier est un TEMPLATE : au démarrage du conteneur, l'image nginx
# officielle remplace ${BACKEND_URL} et ${MAX_UPLOAD_SIZE} par la valeur des
# variables d'environnement correspondantes, puis écrit le résultat dans
# /etc/nginx/conf.d/default.conf.
#
#   BACKEND_URL      URL interne du backend (ex : http://backend:3000)
#   MAX_UPLOAD_SIZE  taille maximale d'une requête (ex : 6m)
#
# Le navigateur ne parle QU'AU frontend : toutes les requêtes /api/* sont
# relayées (reverse proxy) vers le backend, qui n'a donc pas besoin d'être
# exposé à l'extérieur du cluster.
# =============================================================================
server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    client_max_body_size ${MAX_UPLOAD_SIZE};

    # --- API : reverse proxy vers le microservice backend --------------------
    location /api/ {
        proxy_pass         ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # --- Sonde de santé du frontend (livenessProbe / readinessProbe) ---------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- Fichiers statiques du site -------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }
}
