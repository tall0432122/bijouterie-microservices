# Copiez ce fichier en .env pour personnaliser le lancement avec docker compose.
# Ne JAMAIS committer le fichier .env (il contient des mots de passe).

# --- Base de données (SENSIBLE) ---
MYSQL_ROOT_PASSWORD=rootpass
DB_NAME=bijouterie
DB_USER=bijoux
DB_PASSWORD=bijouxpass

# --- Paramètres applicatifs (non sensibles) ---
SHOP_NAME=Maison Aurore
CURRENCY=EUR
MAX_FILE_SIZE_MB=5
MAX_UPLOAD_SIZE=6m

# --- Port local du site ---
FRONTEND_PORT=8080
